# Copy to .env and adjust as needed. Auto-loaded via python-dotenv
# (see app/config.py).

# --- Auth / database ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<db-name>
MONGODB_DB_NAME=border

# Generate your own: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me
JWT_EXPIRE_MINUTES=1440

# Only needed on Windows, or if tesseract isn't on PATH.
# VERIDEX_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Override if models live somewhere other than VERIDEX/models/
# VERIDEX_MODELS_DIR=/path/to/models
# VERIDEX_FACE_DETECTOR_MODEL=/path/to/face_detector.tflite
# VERIDEX_FACE_RECOGNIZER_MODEL=/path/to/face_recognition_sface_2021dec.onnx

# Face match cosine-similarity threshold (default 0.363, uncalibrated).
# VERIDEX_FACE_MATCH_THRESHOLD=0.363
